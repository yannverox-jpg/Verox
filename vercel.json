{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/connectors",
      "destination": "/api/connectors.py"
    },
    {
      "source": "/api/browser/jobs",
      "destination": "/api/browser_jobs.py"
    },
    {
      "source": "/api/research",
      "destination": "/api/research.py"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/",
      "destination": "/nexus_dashboard.html"
    }
  ],
  "crons": [
    {
      "path": "/api/opportunities/scan",
      "schedule": "15 6 * * *"
    }
  ]
}
