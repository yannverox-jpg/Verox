{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "builds": [
    {
      "src": "*.html",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://verox-juqt.onrender.com/api/:path*"
    },
    {
      "source": "/",
      "destination": "/nexus_dashboard.html"
    }
  ]
}
