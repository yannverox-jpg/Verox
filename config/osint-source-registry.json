  "shared_pipeline": {
    "stages": [
      "discover_source",
      "check_access_and_license",
      "collect_timestamped_observation",
      "store_raw_evidence",
      "normalize",
      "deduplicate",
      "score_source_quality",
      "link_to_hypothesis",
      "search_counterevidence",
      "evaluate_out_of_sample",
      "human_review"
    ],
    "source_quality_dimensions": [
      "authority",
      "directness",
      "freshness",
      "completeness",
      "independent_corroboration",
      "historical_accuracy",
      "license_status"
    ],
    "mandatory_provenance_fields": [
      "source_id",
      "source_name",
      "source_url_or_identifier",
      "observed_at_utc",
      "event_time_utc_if_applicable",
      "collector_version",
      "raw_record_hash",
      "license_or_terms_status",
      "confidence",
      "verification_status"
    ],
    "evidence_statuses": [
      "unverified",
      "corroborated",
      "verified_primary_source",
      "disputed",
      "stale",
      "retracted"
    ],
    "operational_guardrails": [
      "No look-ahead bias.",
      "No fabricated observations.",
      "Separate model inference from source evidence.",
      "Keep an audit log for all external actions.",
      "Require explicit approval for irreversible or financial actions."
    ]
  }
