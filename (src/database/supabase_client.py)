import os
import httpx

async def save_evidence_to_supabase(query: str, evidence: list):
    supabase_url = os.getenv("SUPABASE_URL")
    supabase_key = os.getenv("SUPABASE_ANON_KEY")
    
    if not supabase_url or not supabase_key:
        return # Si non configuré, le moteur tourne en local pur sans persistance

    headers = {
        "apikey": supabase_key,
        "Authorization": f"Bearer {supabase_key}",
        "Content-Type": "application/json",
        "Prefer": "return=minimal"
    }
    
    payload = {
        "query": query,
        "evidence_data": evidence
    }

    async with httpx.AsyncClient() as client:
        await client.post(f"{supabase_url}/rest/v1/cognitive_logs", json=payload, headers=headers)
